  "semanticHighlighting": true,
  "semanticTokenColors": {
    "enumMember": { "foreground": "#528dab" },
    "variable.constant": { "foreground": "#ad6e34" },
    "variable.defaultLibrary": { "foreground": "#E06C75" }
  },
  "tokenColors": [
    {
      "scope": [ "source.ignore", "keyword.other.definition" ],
      "settings": { "foreground": "#528dab" }
    },
    {
      "scope": [ "storage", "storage.type" ],
      "settings": { "foreground": "#9A3FBF", "fontStyle": "italic" }
    },
    {
      "scope": [ "keyword.control" ],
      "settings": { "foreground": "#9A3FBF", "fontStyle": "italic" }
    },
    {
      "scope": "string",
      "settings": { "foreground": "#ad6e34", "fontStyle": "italic" }
    },
    { "scope": "string.regexp", "settings": { "foreground": "#56B6C2" } },
    {
      "scope": [ "entity.name.function" ],
      "settings": { "foreground": "#1684df" }
    },
    {
      "scope": [ "entity.name.namespace", "entity.name.type.module" ],
      "settings": { "foreground": "#3b914e" }
    },
    {
      "scope": [ "support.function" ],
      "settings": { "foreground": "#1684df" }
    },
    {
      "scope": [
        "meta.class entity.name.type.class",
        "meta.class entity.name.function",
        "new.expr entity.name.function",
        "new.expr support.class"
      ],
      "settings": { "foreground": "#0A7481" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum"
      ],
      "settings": { "foreground": "#2EA7B7" }
    },
    { "scope": [ "meta.at-rule" ], "settings": { "foreground": "#585BCB" } },
    {
      "scope": [
        "variable.other.readwrite.alias",
        "meta.type.annotation entity.name.type",
        "meta.type.parameters entity.name.type",
        "meta.return.type entity.name.type",
        "meta.interface entity.other.inherited-class",
        "meta.object.member variable.other.readwrite",
        "entity.name.type.rust"
      ],
      "settings": { "foreground": "#585BCB" }
    },
    {
      "scope": [ "entity.name.type.struct" ],
      "settings": { "foreground": "#bb8725" }
    },
    {
      "scope": [ "constant.language", "support.type.builtin" ],
      "settings": { "foreground": "#9A3FBF" }
    },
    { "scope": "constant.numeric", "settings": { "foreground": "#0A7481" } },
    {
      "scope": [
        "variable",
        "expression.ng variable.other.readwrite",
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.rust",
        "variable.other.readwrite",
        "keyword.key"
      ],
      "settings": { "foreground": "#528dab" }
    },
    {
      "scope": "punctuation.support.type.property-name",
      "settings": { "foreground": "#9A3FBF" }
    },
    {
      "scope": [ "meta.ng-binding.event expression.ng variable.other.readwrite" ],
      "settings": { "foreground": "#528dab" }
    },
    {
      "scope": [ "variable.other.constant", "support.variable.property" ],
      "settings": { "foreground": "#bb8725" }
    },
    {
      "scope": "variable.other.readwrite",
      "settings": { "foreground": "#528dab" }
    },
    { "scope": "variable.language", "settings": { "foreground": "#E06C75" } },
    { "scope": "variable.scss", "settings": { "foreground": "#bb8725" } },
    {
      "scope": "variable.parameter",
      "settings": { "foreground": "#458774", "fontStyle": "italic" }
    },
    {
      "scope": [ "comment", "punctuation.definition.comment" ],
      "settings": { "foreground": "#9EA4B4" }
    },
    {
      "scope": [
        "source.rust meta.attribute.rust punctuation.definition.attribute.rust"
      ],
      "settings": { "foreground": "#2EA0E8" }
    },
    {
      "scope": [ "source.rust meta.attribute.rust" ],
      "settings": { "foreground": "#9A3FBF" }
    },
    {
      "scope": [ "keyword.operator" ],
      "settings": { "foreground": "#2EA7B7" }
    },
    {
      "scope": [ "keyword.operator.new", "keyword.operator.expression" ],
      "settings": { "foreground": "#9A3FBF" }
    },
    {
      "scope": [ "keyword.operator.type", "meta.brace.round", "punctuation.accessor" ],
      "settings": { "foreground": "#4B5162" }
    },
    {
      "scope": [ "keyword.other.unit" ],
      "settings": { "foreground": "#2EA7B7" }
    },
    {
      "scope": [ "meta.brace.round", "punctuation.accessor" ],
      "settings": { "foreground": "#383C46" }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded.rust"
      ],
      "settings": { "foreground": "#9A3FBF" }
    },
    {
      "scope": [ "punctuation.section.embedded.rust" ],
      "settings": { "foreground": "#bb8725" }
    },
    {
      "scope": [ "support.type.primitive" ],
      "settings": { "foreground": "#2EA7B7" }
    },
    {
      "scope": [ "support.class.builtin", "meta.block entity.name.type" ],
      "settings": { "foreground": "#E06C75" }
    },
    {
      "scope": [ "meta.class support.class.error" ],
      "settings": { "foreground": "#E06C75" }
    },
    { "scope": "entity.name.tag", "settings": { "foreground": "#50AF8E" } },
    {
      "scope": "entity.name.tag support.class.component",
      "settings": { "foreground": "#CC2F3B" }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "punctuation.definition.ng-binding-name"
      ],
      "settings": { "foreground": "#3b914e", "fontStyle": "italic" }
    },
    {
      "scope": "entity.other.attribute-name.id",
      "settings": { "foreground": "#bb8725" }
    },
    {
      "scope": [ "entity.other.attribute-name.class", "punctuation.definition.entity" ],
      "settings": { "foreground": "#ad6e34" }
    },
    {
      "scope": "meta.at-rule.apply.tailwind entity.other.attribute-name.class",
      "settings": { "foreground": "#585BCB" }
    },
    {
      "scope": "entity.other.ng-binding-name",
      "settings": { "foreground": "#50AF8E" }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string.quoted.double punctuation.definition.block",
        "text.html.derivative punctuation.definition.block"
      ],
      "settings": { "foreground": "#8A4A1E" }
    },
    {
      "scope": "support.type.object.module",
      "settings": { "foreground": "#bb8725" }
    },
    {
      "scope": "support.constant.property-value",
      "settings": { "foreground": "#9A3FBF" }
    },
    {
      "scope": [ "support.constant.font-name", "meta.property-value" ],
      "settings": { "foreground": "#bb8725" }
    },
    { "scope": "punctuation", "settings": { "foreground": "#383C46" } },
    {
      "scope": "punctuation.definition.keyword",
      "settings": { "foreground": "#9A3FBF" }
    },
    {
      "scope": "support.type.vendored",
      "settings": { "foreground": "#3b914e" }
    },
    {
      "scope": "constant.character.entity",
      "settings": { "foreground": "#9A3FBF" }
    },
    { "scope": [ "source" ], "settings": { "foreground": "#383C46" } },
    {
      "scope": [ "meta.function-call" ],
      "settings": { "foreground": "#bb8725" }
    },
    { "scope": [ "source.ini" ], "settings": { "foreground": "#ad6e34" } },
    {
      "scope": [ "source.makefile" ],
      "settings": { "foreground": "#528dab" }
    },
    {
      "scope": [
        "keyword.control.makefile",
        "keyword.control.ifeq.makefile",
        "keyword.control.ifneq.makefile",
        "keyword.control.ifdef.makefile",
        "keyword.control.ifndef.makefile",
        "keyword.control.else.makefile",
        "keyword.control.endif.makefile",
        "keyword.other.makefile"
      ],
      "settings": { "foreground": "#9A3FBF", "fontStyle": "italic" }
    },
    {
      "scope": [
        "variable.language.makefile",
        "punctuation.definition.variable.makefile"
      ],
      "settings": { "foreground": "#9A3FBF", "fontStyle": "italic" }
    },
    {
      "scope": [
        "support.function.target.PHONY.makefile",
        "support.function.makefile",
        "meta.scope.function-call.makefile support.function.builtin.makefile"
      ],
      "settings": { "foreground": "#1684df" }
    },
    {
      "scope": [
        "variable.other.makefile",
        "variable.parameter.makefile",
        "string.interpolated.dollar.makefile"
      ],
      "settings": { "foreground": "#458774", "fontStyle": "italic" }
    },
    {
      "scope": [
        "entity.name.function.target.makefile",
        "meta.scope.target.makefile entity.name.function.target.makefile",
        "meta.scope.prerequisites.makefile"
      ],
      "settings": { "foreground": "#2EA7B7" }
    },
    {
      "scope": [ "markup.heading.markdown", "markup.heading entity.name" ],
      "settings": { "foreground": "#1684df" }
    },
    {
      "scope": [ "punctuation.definition.heading.markdown" ],
      "settings": { "foreground": "#E2D4B8" }
    },
    {
      "scope": "markup.inline.raw.markdown",
      "settings": { "foreground": "#ad6e34", "fontStyle": "italic" }
    },
    {
      "scope": "markup.inline.raw.string.markdown",
      "settings": { "foreground": "#ad6e34", "fontStyle": "italic" }
    },
    {
      "scope": "punctuation.definition.raw.markdown",
      "settings": { "foreground": "#ad6e34" }
    },
    {
      "scope": "markup.bold,todo.bold",
      "settings": { "foreground": "#bb8725", "fontStyle": "bold" }
    },
    {
      "scope": "punctuation.definition.bold.markdown",
      "settings": { "foreground": "#bb8725" }
    },
    {
      "scope": [ "markup.italic" ],
      "settings": { "foreground": "#98C379", "fontStyle": "italic" }
    },
    {
      "scope": "punctuation.definition.italic.markdown",
      "settings": { "foreground": "#98C379" }
    },
    {
      "scope": "beginning.ordered.list.markdown",
      "settings": { "foreground": "#0A7481" }
    },
    { "scope": [ "source.python" ], "settings": { "foreground": "#528dab" } },
    {
      "scope": [ "source.python support.type", "support.function.builtin" ],
      "settings": { "foreground": "#2EA7B7", "fontStyle": "italic" }
    },
    {
      "scope": [
        "source.python meta.function",
        "source.python meta.function-call.generic"
      ],
      "settings": { "foreground": "#1684df" }
    },
    { "scope": [ "source.sql" ], "settings": { "foreground": "#528dab" } },
    {
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql",
        "keyword.reserved.sql"
      ],
      "settings": { "foreground": "#9A3FBF", "fontStyle": "italic" }
    },
    {
      "scope": [ "storage.type.sql" ],
      "settings": { "foreground": "#9A3FBF", "fontStyle": "italic" }
    },
    {
      "scope": [
        "support.function.aggregate.sql",
        "support.function.sql",
        "entity.name.function.sql"
      ],
      "settings": { "foreground": "#1684df" }
    },
    {
      "scope": [ "variable.other.sql", "variable.parameter.sql" ],
      "settings": { "foreground": "#458774", "fontStyle": "italic" }
    },
    {
      "scope": [ "entity.name.sql", "entity.name.type.sql" ],
      "settings": { "foreground": "#2EA7B7" }
    }
  ]
}