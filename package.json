{
  "name": "leone-dark",
  "icon": "images/icon.png",
  "displayName": "Leone Dark",
  "description": "Leone Dark - a UI color theme for VS Code based IDEs",
  "version": "0.2.15",
  "license": "MIT",
  "homepage": "https://github.com/brankoleone/leone-dark-vscode-theme.git",
  "repository": {
    "url": "https://github.com/brankoleone/leone-dark-vscode-theme.git",
    "type": "git"
  },
  "publisher": "brankoleone",
  "engines": {
    "vscode": "^1.51.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "Dark Theme",
    "Leone",
    "Leone Dark"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Leone Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Leone Dark-color-theme.json"
      }
    ]
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "publish:patch": "pnpm dlx @vscode/vsce publish patch",
    "publish:minor": "pnpm dlx @vscode/vsce publish minor",
    "publish:major": "pnpm dlx @vscode/vsce publish major",
    "vsix": "pnpm dlx @vscode/vsce package",
    "vsix:theme": "bash scripts/package-theme.sh",
    "generate": "node config/index.js generate",
    "watch": "node config/index.js watch",
    "nvim:install": "bash scripts/install-nvim.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/yargs": "^17.0.7",
    "json-beautify": "^1.1.1",
    "json-templates": "^4.2.0",
    "prettier": "^3.1.1",
    "yargs": "^17.2.1"
  },
  "__metadata": {
    "id": "cc37a445-bbc5-435c-b406-8851b4e280a8",
    "publisherDisplayName": "brankoleone",
    "publisherId": "a7e31eb0-3cfd-404d-a2db-67979587e1a2"
  }
}
